<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>StudyPlax | Statistics</title>
    <link rel="stylesheet" href="styles.css">
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-white text-black font-mono">
    <header class="border-b border-black p-6 flex justify-between items-center">
        <h1 class="text-2xl font-bold tracking-tighter">STUDYPLAX_STATS</h1>
        <nav class="space-x-6 text-sm">
            <a href="index.html" class="hover:underline">Dashboard</a>
            <a href="decks.html" class="hover:underline">Decks</a>
            <a href="stats.html" class="underline">Stats</a>
            <a href="settings.html" class="hover:underline">Settings</a>
        </nav>
    </header>
    <main class="max-w-4xl mx-auto p-8 mt-12">
        <h2 class="text-xl font-bold mb-6">PERFORMANCE ANALYTICS</h2>
        <div class="border border-black p-6 mb-6">
            <h3 class="font-bold mb-4">Total Cards Reviewed: 1,420</h3>
            <div class="h-32 border-b border-l border-black flex items-end justify-between p-4">
                <div class="w-8 bg-black h-12"></div>
                <div class="w-8 bg-black h-24"></div>
                <div class="w-8 bg-black h-16"></div>
                <div class="w-8 bg-black h-28"></div>
                <div class="w-8 bg-black h-20"></div>
                <div class="w-8 bg-black h-32"></div>
            </div>
        </div>
    </main>
</body>
</html>
